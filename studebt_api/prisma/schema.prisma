generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model student {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  age       Int
  major     String   @db.VarChar(50)
  createdAt DateTime @default(now())
}
